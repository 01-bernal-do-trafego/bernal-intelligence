# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local NUNCA deve ser versionado no Git.

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable (anon) do Supabase — segura para uso no browser.
# NÃO use aqui a service_role / secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
