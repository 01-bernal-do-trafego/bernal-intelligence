# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local NUNCA deve ser versionado no Git.

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable (anon) do Supabase — segura para uso no browser.
# NÃO use aqui a service_role / secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do app (origem autoritativa para redirects absolutos, ex.: o
# callback do OAuth da Meta). OBRIGATÓRIA em qualquer deploy atrás de reverse
# proxy (ex.: Hostinger) — sem ela os redirects usam o bind interno do processo
# (https://0.0.0.0:3000). Não é segredo. Sem barra final.
# Dev:  deixe em branco (usa a origem do request)
# Prod: https://SEU-DOMINIO
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Meta Ads — OAuth (META 2). NENHUM destes é segredo:
#   - o App Secret e a chave de cifra NÃO ficam aqui, e sim nos secrets da
#     Edge Function (supabase secrets set) — ver
#     supabase/functions/meta-oauth-exchange/README.md
#   - sem estes valores o botão "Conectar Meta Ads" só mostra um aviso.
# -----------------------------------------------------------------------------

# App ID (Meta for Developers → App settings → Basic)
META_APP_ID=

# Configuration ID da "Facebook Login for Business"
# (Meta for Developers → Facebook Login for Business → Configurations)
META_OAUTH_CONFIG_ID=

# URL do nosso callback. Tem que ser IDÊNTICA à cadastrada em
# "Valid OAuth Redirect URIs" e à secret META_OAUTH_REDIRECT_URI da função.
# Dev:  http://localhost:3000/api/meta/oauth/callback
# Prod: https://SEU-DOMINIO/api/meta/oauth/callback
META_OAUTH_REDIRECT_URI=

# Opcional — base das Edge Functions. Por padrão é derivada de
# NEXT_PUBLIC_SUPABASE_URL. Sobrescreva para o runtime local:
#   http://127.0.0.1:54321/functions/v1
# SUPABASE_FUNCTIONS_URL=

# -----------------------------------------------------------------------------
# Historical Backfill — runner administrativo (DATA V2.3A, `npm run backfill`).
# DEV ONLY nesta etapa — o runner recusa qualquer project-ref que não seja o
# Supabase Dev conhecido (`scripts/backfill/dev-guard.ts`). Nunca preencha
# estes valores aqui; NUNCA são aceitos via argumento de linha de comando.
# -----------------------------------------------------------------------------
BACKFILL_ORCHESTRATOR_URL=
META_BACKFILL_ORCHESTRATOR_SECRET=
BACKFILL_EXECUTOR_URL=
META_BACKFILL_EXECUTOR_SECRET=
# Só exigidas quando o runner usa --all-history (DATA V2.3B, Earliest-Date
# Discovery) — o modo explícito (--from/--to) não precisa delas.
BACKFILL_DISCOVERY_URL=
META_BACKFILL_DISCOVERY_SECRET=
